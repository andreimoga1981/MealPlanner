# From Supabase dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google Gemini API (server-only), used to estimate macros from ingredients.
# aistudio.google.com/apikey → Create API key (free tier available).
GEMINI_API_KEY=
# Optional: comma-separated models to try in order (default gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite).
GEMINI_MODEL=
